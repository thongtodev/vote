rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(board) {
      return signedIn() && (board == 'shared-vote-board-global' || exists(/databases/$(database)/documents/voteBoards/$(board)/members/$(request.auth.uid)));
    }
    match /voteBoards/{board} {
      allow create: if signedIn()
        && board.matches('^[a-zA-Z0-9-]{20,80}$')
        && request.resource.data.keys().hasOnly(['ownerUid','inviteKey','startedDay'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.inviteKey is string
        && request.resource.data.inviteKey.matches('^[a-f0-9]{64}$')
        && request.resource.data.startedDay is string
        && request.resource.data.startedDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow get: if member(board);
      allow list, update, delete: if false;
      match /members/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid','inviteKey'])
          && request.resource.data.uid == uid
          && request.resource.data.inviteKey == get(/databases/$(database)/documents/voteBoards/$(board)).data.inviteKey;
        allow list, update, delete: if false;
      }
      match /meta/{docId} {
        allow read: if member(board);
        allow create, update: if member(board)
          && request.resource.data.keys().hasOnly(['version','count','added','createdAt'])
          && request.resource.data.version is string
          && request.resource.data.count is number
          && request.resource.data.added is number
          && request.resource.data.createdAt is number;
        allow delete: if false;
      }
      match /rows/{rowId} {
        allow read: if member(board);
        allow create, update: if member(board)
          && request.resource.data.keys().hasOnly(['id','mail','pass','recipient','cooldownHours','createdAt','votes'])
          && request.resource.data.id == rowId
          && request.resource.data.mail is string && request.resource.data.mail.size() <= 1000
          && request.resource.data.pass is string && request.resource.data.pass.size() <= 4096
          && request.resource.data.recipient is string && request.resource.data.recipient.size() <= 500
          && request.resource.data.cooldownHours is number
          && request.resource.data.cooldownHours > 0 && request.resource.data.cooldownHours <= 8760
          && request.resource.data.createdAt is number
          && request.resource.data.votes is map;
        allow delete: if member(board);
      }
    }
  }
}
